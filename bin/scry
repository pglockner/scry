#!/usr/bin/env bash
# scry -- like cat, but dispatches to a nicer viewer by file extension.
#
# This file is only the dispatcher. Each file type lives in its own handler
# under share/scry/handlers/ (see the README for the handler API), and
# shared helpers live in share/scry/lib.sh. Run `scry -h` for the table of
# installed handlers and `scry --doctor` to see which helpers are present.
#
# A recognized extension with a missing viewer is a hard error, not a
# silent fallback to cat, so a missing helper is obvious. Like cat, an error
# on one file doesn't stop the rest; the exit status is 1 if any failed.
set -euo pipefail

# Resolve symlinks so a `make link` install still finds the repo's share/.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRY_SELF="$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
SCRY_ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
SCRY_SHARE="${SCRY_SHARE:-$SCRY_ROOT/share/scry}"
SCRY_USER_HANDLERS="${SCRY_USER_HANDLERS:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/scry/handlers}"

if [ ! -r "$SCRY_SHARE/lib.sh" ]; then
    echo "scry: can't find $SCRY_SHARE/lib.sh (broken install? try: make install)" >&2
    exit 1
fi
# shellcheck source=../share/scry/lib.sh
. "$SCRY_SHARE/lib.sh"

# Built-in handlers first, then the user's, so the user's win on conflicts.
for f in "$SCRY_SHARE"/handlers/*.sh "$SCRY_USER_HANDLERS"/*.sh; do
    if [ -f "$f" ]; then
        # shellcheck disable=SC1090
        . "$f"
    fi
done

show_help() {
    cat <<'EOF'
scry - like cat, but dispatches to a nicer viewer based on file extension

Usage:
  scry [OPTIONS] FILE...   view one or more files (dispatched independently)
  scry DIR                 list directory contents (ls -la)
  cmd | scry               read piped stdin like cat (also: FILE is -)

Options (may come before or after files; short ones combine, e.g. -fA):
  -f, --full        force the "full" variant -- see (-f: ...) notes below
  -A, --show-all    skip the handlers; show the file with bat --show-all
                    (tabs, spaces, line endings and other non-printables)
  -p, --preview     non-interactive output for previewers: no windows,
                    pagers or players; fits $FZF_PREVIEW_COLUMNS
  -t, --type EXT    treat every file (and stdin) as if it ended in .EXT,
                    e.g. `curl -s URL | scry -t md`
  --fzf [DIR]       pick files under DIR (default .) with fzf and
                    scry --preview, then view the selection
  --doctor          show which helpers are installed
  --                end of options (for file names starting with -)
  -h, --help        show this help

Handlers (extension -> viewer):
EOF
    local i e exts
    for ((i = 0; i < ${#SCRY_H_NAMES[@]}; i++)); do
        exts=""
        for e in ${SCRY_H_EXTS[$i]}; do exts="$exts .$e"; done
        printf '  %-9s %s\n' "${SCRY_H_NAMES[$i]}" "${exts# }"
        printf '  %-9s   %s\n' "" "${SCRY_H_HELP[$i]}"
    done
    cat <<'EOF'
  (other)   anything else: bat, or plain cat if bat isn't installed

A recognized extension with a missing viewer is a hard error (not a
silent fallback), so a missing helper is obvious immediately.
Set SCRY_DEBUG=1 to print detected terminal width to stderr.
EOF
    echo "Handlers load from $SCRY_SHARE/handlers and $SCRY_USER_HANDLERS."
}

# Report which helpers the loaded handlers declared and whether each is present.
doctor() {
    local i bin missing=0
    echo "scry helpers ($SCRY_PLATFORM):"
    for ((i = 0; i < ${#SCRY_HELPERS[@]}; i++)); do
        bin="${SCRY_HELPERS[$i]}"
        if command -v "$bin" >/dev/null 2>&1; then
            printf '  ok       %-8s %s\n' "$bin" "${SCRY_HELPER_ENABLES[$i]}"
        else
            printf '  MISSING  %-8s %s\n           install: %s\n' \
                "$bin" "${SCRY_HELPER_ENABLES[$i]}" "${SCRY_HELPER_HINTS[$i]}"
            missing=1
        fi
    done
    [ -z "$SCRY_DOCTOR_NOTE" ] || echo "$SCRY_DOCTOR_NOTE"
    [ "$missing" -eq 0 ] || echo "Only install the ones for file types you actually view."
}

view_one() {
    local file="$1" name handler
    # shellcheck disable=SC2034  # read by the platform layer
    SCRY_FILE="$1"
    if [ -d "$file" ]; then
        ls -la -- "$file"
        return
    fi
    if [ "$file" != - ]; then
        if [ ! -e "$file" ]; then
            echo "scry: $file: No such file or directory" >&2
            return 1
        elif [ ! -r "$file" ]; then
            echo "scry: $file: Permission denied" >&2
            return 1
        fi
        # Not every viewer takes `--` (afplay, imgcat, bsdtar -f don't), so
        # pin a dash-leading name as a path once, here, for all of them.
        case "$file" in -*) file="./$file" ;; esac
    fi
    if [ "$SCRY_RAW" = "1" ]; then
        scry_require "$SCRY_BAT" "$SCRY_INSTALL bat  (-A needs bat)"
        scry_bat_view -- "$file"
        return
    fi
    name="$file"
    [ -n "$SCRY_TYPE" ] && name="stdin.$SCRY_TYPE"
    if ! handler="$(scry_find_handler "$name")"; then
        scry_fallback "$file"
        return
    fi
    if [ "$file" = - ]; then
        spool_stdin
        file="$SCRY_TMP/$name"
    fi
    if [ "$SCRY_PREVIEW" != "1" ]; then
        "scry_view_$handler" "$file"
    elif declare -F "scry_preview_$handler" >/dev/null; then
        "scry_preview_$handler" "$file"
    else
        scry_info "$file"
    fi
}

# Handlers take a path, so save stdin to $SCRY_TMP/stdin.EXT (Quick Look and
# friends go by extension), then give interactive viewers (visidata, pagers)
# the terminal back as their stdin.
spool_stdin() {
    scry_tmp
    cat > "$SCRY_TMP/stdin.$SCRY_TYPE"
    if { : </dev/tty; } 2>/dev/null; then
        exec </dev/tty
    fi
}

# view FILE -- view_one in a subshell of its own, so a handler's `exit` or
# a failed command ends only this file's view, and per-file state
# ($SCRY_TMP, $SCRY_DETACHED) starts fresh and is cleaned up after it.
# A failure sets SCRY_STATUS=1 rather than returning it: calling view in
# `view f || ...` would make bash ignore set -e inside the handler.
SCRY_STATUS=0
view() {
    set +e
    (
        set -e
        trap scry_cleanup EXIT
        trap 'exit 143' TERM HUP   # so a killed preview still cleans up
        view_one "$1"
    )
    # shellcheck disable=SC2181  # `if ( ... )` is the very context to avoid
    [ "$?" -eq 0 ] || SCRY_STATUS=1
    set -e
}

# Pick files with fzf, previewing each with `scry --preview`, then view the
# selection (Tab to multi-select). Flags given with --fzf carry over.
fzf_pick() {
    local dir="${1:-.}" preview selection file
    scry_require fzf "$SCRY_INSTALL fzf"
    preview="$(printf '%q' "$SCRY_SELF") --preview"
    [ "$SCRY_RAW" = "1" ] && preview="$preview -A"
    [ -n "$SCRY_TYPE" ] && preview="$preview -t $(printf '%q' "$SCRY_TYPE")"
    # fzf exits non-zero when cancelled; that's not an error here.
    selection="$(find "$dir" -type f -not -path '*/.git/*' 2>/dev/null \
        | sort | fzf -m --layout=reverse --preview "$preview -- {}" --preview-window=right:60%)" || return 0
    # Read the list on fd 3 so each viewer keeps the real terminal as stdin;
    # interactive ones (pager, visidata) need it.
    while IFS= read -r file <&3; do
        view "$file"
    done 3<<<"$selection"
}

usage_error() {
    echo "scry: $1 (try: scry -h)" >&2
    exit 2
}

# Options may come anywhere (until --); everything else is a file.
MODE=view
files=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)      show_help; exit 0 ;;
        --doctor)       doctor; exit 0 ;;
        -f|--full)      FORCE_WINDOW=1 ;;
        -A|--show-all)  SCRY_RAW=1 ;;
        -p|--preview)   SCRY_PREVIEW=1 ;;
        --fzf)          MODE=fzf ;;
        -t|--type)
            [ "$#" -ge 2 ] || usage_error "option '$1' needs an extension"
            SCRY_TYPE="$2"
            shift
            ;;
        --type=*)       SCRY_TYPE="${1#--type=}" ;;
        -t?*)           SCRY_TYPE="${1#-t}" ;;
        --)             shift; files+=("$@"); break ;;
        -[!-]?*)
            # Split combined short options: -fA -> -f -A.
            rest="${1#-?}"
            set -- "${1%"$rest"}" "-$rest" "${@:2}"
            continue
            ;;
        -?*)            usage_error "unknown option '$1'" ;;
        *)              files+=("$1") ;;
    esac
    shift
done
# bash 3.2 treats "${files[@]}" of an empty array as unbound under set -u.
set -- ${files[@]+"${files[@]}"}

# -t md, -t .md and -t MD all mean the same; the type ends up in a file name.
SCRY_TYPE="$(scry_lower "${SCRY_TYPE#.}")"
case "$SCRY_TYPE" in */*) usage_error "bad type '$SCRY_TYPE'" ;; esac

# A preview never opens a window, so --preview overrides -f.
[ "$SCRY_PREVIEW" = "1" ] && FORCE_WINDOW=0

if [ "$MODE" = "fzf" ]; then
    fzf_pick "$@"
    exit "$SCRY_STATUS"
fi

# `scry the future`, when there are no such files.
if [ "$#" -eq 2 ] && [ "$1" = the ] && [ "$2" = future ] \
    && [ ! -e the ] && [ ! -e future ]; then
    fortunes=(
        "you will soon \`brew install\` something you never use."
        "a .DS_Store approaches from the north."
        "your next grep finds exactly one match. The wrong one."
        "a stranger will send you a .heic. Do not be afraid."
        "beware the file named final_v2_REAL.docx."
    )
    cat <<'EOF'
        .-""-.
       / .  * \
      |  *  .  |
       \ .  * /
        '-..-'
       _/____\_
EOF
    printf '\nThe mists part... %s\n' "${fortunes[RANDOM % ${#fortunes[@]}]}"
    exit 0
fi

if [ "$#" -eq 0 ]; then
    if [ -t 0 ] && [ -z "$SCRY_TYPE" ]; then
        show_help
        exit 0
    fi
    set -- -
fi

for f in "$@"; do
    view "$f"
done
exit "$SCRY_STATUS"
